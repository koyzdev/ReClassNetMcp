<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<AssemblyName>ReClassNetMcp</AssemblyName>
		<RootNamespace>ReClassNetMcp</RootNamespace>
		<OutputType>Library</OutputType>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<LangVersion>latest</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<DebugType>portable</DebugType>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
	</PropertyGroup>

	<PropertyGroup>
		<Product>ReClass.NET Plugin</Product>
		<AssemblyTitle>MCP Server</AssemblyTitle>
		<Description>Model Context Protocol server for ReClass.NET</Description>
		<Company>ReClassNetMcp</Company>
		<Version>0.1.0</Version>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
		<Copyright>MIT</Copyright>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>

	<PropertyGroup>
		<ReClassNetAssembly Condition="'$(ReClassNetAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\external\ReClass.NET\bin\Release\x64\ReClass.NET.exe</ReClassNetAssembly>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="ReClass.NET">
			<HintPath>$(ReClassNetAssembly)</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>ReClassNetMcp.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<Target Name="VerifyReClassNetAssembly" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(ReClassNetAssembly)')" Text="ReClass.NET.exe not found at '$(ReClassNetAssembly)'. Run build.ps1 (it builds the submodule first), or pass /p:ReClassNetAssembly=&lt;path to ReClass.NET.exe&gt;." />
	</Target>

</Project>
